APP_PASSWORD=replace-with-a-long-random-password
# RunPod's HTTPS proxy requires secure cookies. Set false only for local HTTP development.
COOKIE_SECURE=true
# Optional: default is 20 GiB; this also limits a project ZIP's extracted files.
MAX_UPLOAD_GB=20
# Optional: default is 8 MiB. Use a smaller whole-MiB value for slower or less reliable proxies.
UPLOAD_CHUNK_MB=8
# Shared RunPod network-volume path. Override to a local folder for non-container development.
WORKSPACE_ROOT=/workspace/blendrender
